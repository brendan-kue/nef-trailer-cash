rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // South Africa time (UTC+2)
    function sa() { return request.time + duration.value(2, 'h'); }
    function todayNum() { return sa().year() * 10000 + sa().month() * 100 + sa().day(); }
    function weekday() { return sa().dayOfWeek() <= 5; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      function old() { return resource.data; }
      function nu() { return request.resource.data; }
      function onlyKeys() {
        return nu().diff(old()).affectedKeys().hasOnly(['coins', 'day', 'ratings', 'name', 'phone', 'lastWithdrawal', 'updatedAt']);
      }
      function earn() {
        return verified() && weekday()
          && nu().day == todayNum()
          && nu().coins == old().coins + 50
          && nu().ratings.size() <= 5
          && ((old().day == todayNum() && nu().ratings.size() == old().ratings.size() + 1)
              || (old().day != todayNum() && nu().ratings.size() == 1));
      }
      function withdraw() {
        return verified()
          && nu().ratings == old().ratings && nu().day == old().day
          && nu().coins < old().coins && nu().coins >= 0
          && nu().lastWithdrawal != old().get('lastWithdrawal', '')
          && existsAfter(/databases/$(database)/documents/users/$(uid)/withdrawals/$(nu().lastWithdrawal))
          && getAfter(/databases/$(database)/documents/users/$(uid)/withdrawals/$(nu().lastWithdrawal)).data.coinsCost == old().coins - nu().coins;
      }
      function profileOnly() {
        return nu().coins == old().coins && nu().ratings == old().ratings && nu().day == old().day
          && nu().get('lastWithdrawal', '') == old().get('lastWithdrawal', '');
      }

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && nu().coins == 100 && nu().ratings.size() == 0 && nu().day == 0
        && nu().keys().hasOnly(['name', 'email', 'phone', 'coins', 'day', 'ratings', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid == uid && onlyKeys()
        && (earn() || withdraw() || profileOnly());
      allow delete: if false;

      match /withdrawals/{wid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if verified() && request.auth.uid == uid
          && request.resource.data.status == 'Pending'
          && request.resource.data.coinsCost is int
          && request.resource.data.coinsCost >= 500
          && request.resource.data.coinsCost == request.resource.data.amountCents
          && request.resource.data.method in ['airtime', 'ewallet', 'bank']
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastWithdrawal == wid;
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt', 'note']);
        allow delete: if false;
      }
    }

    match /{path=**}/withdrawals/{wid} {
      allow read: if isAdmin();
    }
  }
}
